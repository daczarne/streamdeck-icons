{
  "version": "2.0.0",
  // Every task's terminal closes when the task exits, going back to the terminal that was open before. run-task.sh
  // keeps it open on failure, until Enter is pressed.
  "presentation": {
    "close": true,
  },
  "tasks": [
    // The default build task, so "Tasks: Run Build Task" runs it. Linked packs need no restart: Stream Deck shows the
    // new icons the next time the Icon Library opens.
    {
      "label": "Build packs",
      "detail": "Regenerate every icon pack, then check them",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run icons && npm run check:icons'",
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": [ ],
    },
    // Unlike CI, which runs its jobs in parallel, the compound task stops at the first check that fails.
    {
      "label": "Lint",
      "detail": "Run every linter and the packs' check",
      "dependsOn": [
        "Lint: Markdown",
        "Lint: spelling",
        "Lint: code",
        "Lint: packs",
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: Markdown",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'markdownlint-cli2 --config .markdownlint.yaml .'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: spelling",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'cspell lint --config .cspell.json --dot --no-progress .'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: code",
      "detail": "Biome: lint, formatting and import order",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run lint'",
      "problemMatcher": [ ],
    },
    {
      "label": "Lint: packs",
      "type": "shell",
      "command": "sh .vscode/run-task.sh 'npm run check:icons'",
      "problemMatcher": [ ],
    },
  ],
}
