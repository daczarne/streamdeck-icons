{
  "name": "@daczarne/streamdeck-icons",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck icon packs, and the glyphs and palette they share with Stream Deck plugins.",
  "license": "MIT",
  "author": "Daniel Czarnievicz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daczarne/streamdeck-icons.git"
  },
  "bugs": {
    "url": "https://github.com/daczarne/streamdeck-icons/issues"
  },
  "homepage": "https://github.com/daczarne/streamdeck-icons#readme",
  "keywords": [
    "streamdeck",
    "elgato",
    "icons",
    "icon-pack"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "icons": "node scripts/generate-packs.mjs",
    "types": "tsc -p tsconfig.types.json",
    "check:icons": "node scripts/check-packs.mjs",
    "lint": "biome ci",
    "typecheck": "tsc -p .",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "biome check --write --linter-enabled=false",
    "link": "node scripts/link-packs.mjs",
    "unlink": "node scripts/link-packs.mjs --unlink"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "opentype.js": "2.0.0",
    "typescript": "6.0.3"
  }
}
